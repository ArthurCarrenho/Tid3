<?xml version="1.0" encoding="utf-8"?>

<Page
    x:Class="TidalUi3.Pages.SearchResultsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:TidalUi3.Controls"
    mc:Ignorable="d">

    <Grid>
        <controls:LoadingOverlayControl x:Name="SearchLoading" />
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,16,0">
            <StackPanel Spacing="28" Padding="36,24,36,120">

                <TextBlock x:Name="PageHeader" Style="{StaticResource TitleLargeTextBlockStyle}" Margin="0,0,0,-16" />

                <!-- Each row shows the first results; "see all" pages through the rest. -->
                <controls:CarouselSectionControl x:Name="ArtistsCarousel" Visibility="Collapsed"
                                                 ItemTemplateSelector="{StaticResource SectionItemTemplateSelector}"
                                                 ItemClick="CardItem_Click" ShowAllClick="ArtistsShowAll_Click" />

                <controls:CarouselSectionControl x:Name="AlbumsCarousel" Visibility="Collapsed"
                                                 ItemTemplateSelector="{StaticResource SectionItemTemplateSelector}"
                                                 ItemClick="CardItem_Click" ShowAllClick="AlbumsShowAll_Click" />

                <controls:CarouselSectionControl x:Name="PlaylistsCarousel" Visibility="Collapsed"
                                                 ItemTemplateSelector="{StaticResource SectionItemTemplateSelector}"
                                                 ItemClick="CardItem_Click" ShowAllClick="PlaylistsShowAll_Click" />

                <!-- Songs Section -->
                <StackPanel x:Name="SongsSection" Spacing="12" Visibility="Collapsed">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="SongsTitle" Style="{StaticResource SubtitleTextBlockStyle}"
                                   VerticalAlignment="Center" />
                        <HyperlinkButton x:Name="SongsShowAll" x:Uid="Section_ShowAll" Grid.Column="1"
                                         Visibility="Collapsed" Click="SongsShowAll_Click" />
                    </Grid>
                    <ListView x:Name="SearchResultsList" SelectionMode="None" IsItemClickEnabled="True"
                              ItemClick="TrackItem_Click" RightTapped="TrackItem_RightTapped">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <controls:TrackListItemControl ShowRowNumber="False" ShowHeart="False"
                                                               AlbumColumnWidth="0.5*" />
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
