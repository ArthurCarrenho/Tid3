<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="TidalUi3.Pages.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:TidalUi3.Models"
    xmlns:controls="using:TidalUi3.Controls"
    mc:Ignorable="d"
>

    <Grid>
        <controls:LoadingOverlayControl x:Name="HomeLoading" />
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,16,0">
            <StackPanel Spacing="32" Padding="36,24,36,120">

                <!-- Header -->
                <TextBlock
                    x:Uid="HomeHeader"
                    Style="{StaticResource TitleLargeTextBlockStyle}"
                    Margin="0,0,0,-16"
                />

                <!-- Sections of TIDAL's "for you" page, built by PageSectionsBuilder -->
                <StackPanel x:Name="SectionsHost" Spacing="32" />

                <!-- Shown instead of an empty page when loading failed, e.g. offline -->
                <StackPanel
                    x:Name="LoadErrorPanel"
                    Visibility="Collapsed"
                    Spacing="16"
                    Margin="0,48,0,0"
                    HorizontalAlignment="Center"
                >
                    <controls:EmptyStateControl x:Uid="HomeLoadError" IconGlyph="&#xE7BA;" />
                    <Button
                        x:Uid="HomeLoadError_Retry"
                        HorizontalAlignment="Center"
                        Click="RetryButton_Click"
                    />
                </StackPanel>

            </StackPanel>
        </ScrollViewer>
    </Grid>

</Page>
