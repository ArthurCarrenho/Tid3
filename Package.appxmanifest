<?xml version="1.0" encoding="utf-8"?>

<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:mp="http://schemas.microsoft.com/appx/2014/phone/manifest"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  xmlns:uap5="http://schemas.microsoft.com/appx/manifest/uap/windows10/5"
  xmlns:com="http://schemas.microsoft.com/appx/manifest/com/windows10"
  xmlns:desktop="http://schemas.microsoft.com/appx/manifest/desktop/windows10"
  IgnorableNamespaces="uap rescap uap5">

  <Identity
    Name="9b35e7a7-4dc6-4684-9948-2bd6a1e5b377"
    Publisher="CN=Arthur Carrenho"
    Version="1.0.0.0" />

  <mp:PhoneIdentity PhoneProductId="9b35e7a7-4dc6-4684-9948-2bd6a1e5b377" PhonePublisherId="00000000-0000-0000-0000-000000000000"/>

  <Properties>
    <DisplayName>Tid3</DisplayName>
    <PublisherDisplayName>Arthur Carrenho</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Universal" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
  </Dependencies>

  <Resources>
    <Resource Language="x-generate"/>
  </Resources>

  <Applications>
    <Application Id="App"
      Executable="$targetnametoken$.exe"
      EntryPoint="$targetentrypoint$">
      <uap:VisualElements
        DisplayName="Tid3"
        Description="Tid3"
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png" />
        <uap:SplashScreen Image="Assets\SplashScreen.png" />
      </uap:VisualElements>
      <Extensions>
        <uap5:Extension Category="windows.startupTask">
          <uap5:StartupTask TaskId="Tid3Startup" Enabled="false" DisplayName="Tid3" />
        </uap5:Extension>

        <!--
          Windows App SDK app notifications require a packaged app to declare its COM
          activator here. Without it AppNotificationManager.Register() fails with
          "No COM servers are registered for this app" and every toast is dropped.
        -->
        <com:Extension Category="windows.comServer">
          <com:ComServer>
            <com:ExeServer Executable="TidalUi3.exe" DisplayName="Tid3" Arguments="----AppNotificationActivated:">
              <com:Class Id="68415043-3F17-4CBD-9E38-F9F3B58035E0" />
            </com:ExeServer>
          </com:ComServer>
        </com:Extension>

        <desktop:Extension Category="windows.toastNotificationActivation">
          <desktop:ToastNotificationActivation ToastActivatorCLSID="68415043-3F17-4CBD-9E38-F9F3B58035E0" />
        </desktop:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
